{
  "name": "lm-commons/lmc-rbac-role-provider-doctrine-orm",
  "description": "Doctrine ORM based Role Provider for LmcRbac",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Eric Richer",
      "email": "eric.richer@vistoconsulting.com"
    }
  ],
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "lm-commons/lmc-rbac": "^2.3",
    "doctrine/persistence": "^3.0 || ^4.0"
  },
  "require-dev": {
    "doctrine/orm": "^3.5.8",
    "laminas/laminas-coding-standard": "^3.1",
    "phpunit/phpunit": "^11.5.42",
    "psalm/plugin-phpunit": "^0.19.5",
    "symfony/cache": "^7.0 || ^8.0",
    "vimeo/psalm": "^6.13"
  },
  "autoload": {
    "psr-4": {
      "Lmc\\Rbac\\Role\\Doctrine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LmcTest\\Rbac\\Role\\Doctrine\\": "test/"
    }
  },
  "extra": {
    "laminas": {
      "component": "Lmc\\Rbac\\Role\\Doctrine",
      "config-provider": "Lmc\\Rbac\\Role\\Doctrine\\ConfigProvider"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.99"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./build/logs/clover.xml",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test-coverage-html": "phpunit --coverage-html ./build/html",
    "static-analysis": "psalm --shepherd --stats",
    "static-analysis-update-baseline": "psalm --shepherd --stats --update-baseline"
  }
}
